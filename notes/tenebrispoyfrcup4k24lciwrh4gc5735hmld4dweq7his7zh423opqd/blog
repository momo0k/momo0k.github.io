int main(void)
{
    int connection;

    // Buffer for incoming HTTP request data
    char buffer[1023];

    // Used to null-terminate the received request
    char null_byte;

    // Size of sockaddr struct
    socklen_t socket_length;

    // Client socket address info
    struct sockaddr client_addr;

    // Server socket address info
    struct sockaddr server_addr;

    // File descriptor for accepted client connection
    int client_socket;

    // Main server socket
    int server_socket;

    // Create TCP socket
    // AF_INET = IPv4
    // SOCK_STREAM = TCP
    server_socket = socket(AF_INET, SOCK_STREAM, 0);

    if (server_socket == -1) {
        perror("Socket creation failed");
    }
    else {

        // Configure server address
        server_addr.sa_family = AF_INET;

        // htons converts host byte order -> network byte order
        // 0x15b3 = 5555
        server_addr.sa_data._0_2_ = htons(5555);

        // Bind to 0.0.0.0 (all interfaces)
        server_addr.sa_data[2] = '\0';
        server_addr.sa_data[3] = '\0';
        server_addr.sa_data[4] = '\0';
        server_addr.sa_data[5] = '\0';

        // Bind socket to port 5555
        connection = bind(server_socket, &server_addr, 0x10);

        if (connection == -1) {
            perror("Bind failed");
        }
        else {

            // Start listening for incoming connections
            // backlog = 10 pending connections
            connection = listen(server_socket, 10);

            if (connection == -1) {
                perror("Listen failed");
            }
            else {

                printf("Server running on http://localhost:%d\n", 1234);

                // Main server loop
                while (true) {

                    socket_length = 0x10;

                    // Accept incoming client connection
                    client_socket =
                        accept(server_socket,
                               &client_addr,
                               &socket_length);

                    if (client_socket == -1)
                        break;

                    // Null-terminate of the buffer is missing
                    // Read request data from client
                    read(client_socket, buffer, 0x3ff);

                    // Null terminate request string
                    null_byte = 0;

                    // Process HTTP request
                    handle_request(client_socket, buffer);

                    // Close client connection
                    close(client_socket);
                }

                perror("Accept failed");
            }
        }
    }

    return 1;
}

we check the handle_request:

void handle_request(int client_socket, char *request_buffer)
{
    int result;

    // HTTP method (GET, POST, etc.)
    char *method;

    // Requested path (/index.html, /api, etc.)
    char *path;

    // Buffer for POST body
    void *post_data;

    /*
        strtok splits the request string into tokens.

        Example HTTP request:

        "GET /index HTTP/1.1"

        Tokens become:
            method  = "GET"
            path    = "/index"
            version = "HTTP/1.1"
    */

    // First token = HTTP method
    method = strtok(request_buffer, " \t\r\n");

    // Second token = path/URL
    path = strtok(NULL, " \t\r\n");

    // Third token = HTTP version
    strtok(NULL, " \t\r\n");

    // Check if request method is GET
    result = strcmp(method, "GET");

    if (result == 0) {

        // Handle GET request
        handle_get_request(client_socket);
    }
    else {

        // Check if request method is DEBUG
        result = strcmp(method, "DEBUG");

        if (result == 0) {

            // Custom/non-standard HTTP method
            handle_debug_request(client_socket, path);
        }
        else {

            // Check if request method is POST
            result = strcmp(method, "POST");

            if (result == 0) {

                // Allocate memory for POST body
                post_data = malloc(0x400);

                // Read POST data from socket
                read(client_socket, post_data, 0x400);

                // Null terminate POST body
                *(char *)((long)post_data + 0x400) = 0;

                // Handle POST request
                handle_post_request(client_socket, path);

                // Free allocated memory
                free(post_data);
            }
            else {

                // Unknown HTTP method
                printf("xyz");
            }
        }
    }

    return;
}

and the handle_debug_request method:

void handle_debug_request(int client_socket, char *user_input)
{
    // Length of response
    size_t length;

    // Stack buffer
    char buffer[42];

    // Manual null terminator
    char null_byte;

    // Check if path/input exists
    if (user_input == NULL) {

        // Send error message to client
        write(client_socket,
              "Socket Connection Error",
              0x16);
    }
    else {

        /*
            DANGEROUS:

            user_input is used directly as format string.
        */
        sprintf(buffer, user_input);

        // Null terminate buffer
        null_byte = 0;

        // Calculate output length
        length = strlen(buffer);

        // Send result back to client
        write(client_socket, buffer, length);
    }

    return;
}

and finally

void handle_post_request(uint64_t client_socket, void *post_data)
{
    // Small local stack buffer (16 bytes only)
    char local_buffer[16];

    /*
        Copy 0x400 bytes (1024 bytes)
        from post_data into local_buffer

        HUGE overflow:
        destination = 16 bytes
        copied data = 1024 bytes
    */
    memcpy(local_buffer, post_data, 0x400);

    return;
}

